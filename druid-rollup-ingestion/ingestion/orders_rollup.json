{
  "type": "index_parallel",
  "spec": {
    "dataSchema": {
      "dataSource": "orders_rollup",
      "timestampSpec": { "column": "ts", "format": "iso" },
      "dimensionsSpec": { "dimensions": ["category", "customer"] },
      "metricsSpec": [
        { "type": "count", "name": "count" },
        { "type": "longSum", "name": "quantity", "fieldName": "quantity" },
        { "type": "doubleSum", "name": "revenue", "fieldName": "revenue" }
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "DAY",
        "queryGranularity": "DAY",
        "rollup": true
      },
      "transformSpec": {
        "transforms": [
          { "type": "expression", "name": "revenue", "expression": "cast(\"quantity\", 'DOUBLE') * cast(\"price\", 'DOUBLE')" }
        ]
      }
    },
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": { "type": "local", "baseDir": "/data", "filter": "orders.csv" },
      "inputFormat": { "type": "csv", "findColumnsFromHeader": true },
      "appendToExisting": false
    },
    "tuningConfig": {
      "type": "index_parallel",
      "partitionsSpec": { "type": "dynamic" },
      "maxNumConcurrentSubTasks": 1
    }
  }
}
