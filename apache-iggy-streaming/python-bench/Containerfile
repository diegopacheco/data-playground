FROM ghcr.io/astral-sh/uv:0.10.4 AS uv

FROM docker.io/library/rust:1.99.1-slim-trixie AS rust

FROM docker.io/library/python:3.15.2-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM docker.io/library/python:3.15.2-slim
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY streambench/ streambench/
ENTRYPOINT ["/opt/venv/bin/python", "-m", "streambench.main"]
