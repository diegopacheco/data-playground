FROM ghcr.io/astral-sh/uv:0.10.4 AS uv

FROM docker.io/library/python:3.15.2-slim
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backfill/ backfill/
ENTRYPOINT ["/opt/venv/bin/python", "-m", "backfill.main"]
