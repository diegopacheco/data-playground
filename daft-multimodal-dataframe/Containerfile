FROM docker.io/library/python:3.14.7-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
ENV FASTEMBED_CACHE_PATH=/models PYTHONUNBUFFERED=1 DAFT_PROGRESS_BAR=0 DAFT_ANALYTICS_ENABLED=0 DO_NOT_TRACK=true SCARF_NO_ANALYTICS=true
COPY app/embed.py app/embed.py
RUN cd app && python -c "import embed; embed.warm()"
ENV HF_HUB_OFFLINE=1
COPY data data
COPY app app
RUN python app/generate_images.py
WORKDIR /app/app
CMD ["python", "server.py"]
