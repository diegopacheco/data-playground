FROM docker.io/library/rust:1.98.1-slim AS build
WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src src
COPY static static
RUN cargo build --release

FROM docker.io/library/debian:trixie-slim
WORKDIR /app
COPY --from=build /app/target/release/parquet-rust-arrow /usr/local/bin/parquet-rust-arrow
COPY data/orders.csv data/orders.csv
ENV PORT=21280
EXPOSE 21280
CMD ["parquet-rust-arrow", "serve"]
