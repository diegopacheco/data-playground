FROM docker.io/library/maven:3.9.16-eclipse-temurin-25 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src src
COPY data data
RUN mvn -q -B -DskipTests package

FROM docker.io/library/eclipse-temurin:25.0.4_7-jre
WORKDIR /app
COPY --from=build /build/target/flight-server.jar /app/flight-server.jar
COPY --from=build /build/target/lib /app/lib
COPY data /app/data
ENV JAVA_TOOL_OPTIONS="-Xms256m -Xmx512m -XX:MaxDirectMemorySize=512m --add-opens=java.base/java.nio=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED"
EXPOSE 21300 21301
ENTRYPOINT ["java", "-jar", "/app/flight-server.jar"]
