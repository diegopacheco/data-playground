{
  "name": "sql-playground",
  "private": true,
  "version": "1.0.0",
  "description": "A PostgreSQL 18 playground with query plans, timing, hints, contention problems and a 5M row dataset.",
  "author": "Diego Pacheco",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "backend": "node backend/server.js",
    "test": "node --test --test-concurrency=1 \"backend/test/*.test.js\"",
    "electron": "electron electron/main.cjs"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "44.4.5",
    "electron-builder": "latest",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "com.diegopacheco.sqlplayground",
    "productName": "SQL Playground",
    "directories": { "output": "release" },
    "npmRebuild": false,
    "files": [
      "assets/icon.png",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "target": ["dir"]
    }
  }
}
