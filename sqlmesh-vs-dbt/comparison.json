  "features": [
    {
      "feature": "Change classification",
      "sqlmesh": "Automatic per plan: BREAKING / NON_BREAKING / INDIRECT_*",
      "dbt": "None: state:modified marks the node and everything downstream"
    },
    {
      "feature": "Environments",
      "sqlmesh": "Virtual: dev is a set of views over versioned physical tables, promotion is a view swap",
      "dbt": "Physical: every target schema is rebuilt, --defer only reads prod relations"
    },
    {
      "feature": "Incremental semantics",
      "sqlmesh": "INCREMENTAL_BY_TIME_RANGE with tracked intervals, restate any date range",
      "dbt": "is_incremental() filter written by hand (max(ts)), reprocess needs --full-refresh"
    },
    {
      "feature": "Column-level lineage",
      "sqlmesh": "Built in, parsed with sqlglot",
      "dbt": "Not in dbt-core (node level from manifest.json)"
    },
    {
      "feature": "Data quality",
      "sqlmesh": "Audits run on every backfill (blocking)",
      "dbt": "Data tests run by dbt test / dbt build"
    },
    {
      "feature": "Change selection",
      "sqlmesh": "Computed from model fingerprints in the state DB",
      "dbt": "state:modified+ against a saved manifest.json"
    }
  ],
